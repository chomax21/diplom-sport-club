# ==== PostgreSQL ====
POSTGRES_DB=sports_club
POSTGRES_USER=sports_club
POSTGRES_PASSWORD=sports_club
POSTGRES_PORT=5433

# ==== Порты приложения ====
BACKEND_PORT=8000
ADMINER_PORT=8080

# ==== Backend ====
# Для локального запуска без Docker используйте localhost.
# В docker-compose значение DATABASE_URL переопределяется автоматически.
DATABASE_URL=postgresql+asyncpg://sports_club:sports_club@localhost:5433/sports_club

ENVIRONMENT=development
DEBUG=false

# Сгенерируйте свой ключ: openssl rand -hex 32
SECRET_KEY=change-me-in-production

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# JSON-массив Origin'ов фронтенда
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Провайдер платежей: mock | (позже можно добавить реальный)
PAYMENT_PROVIDER=mock
DEFAULT_CURRENCY=RUB
